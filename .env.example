# PACTUM frontend environment — copy to .env.local and adjust.
# deploy/deployScript.ts writes these automatically after a finalized deploy.

# Canonical Studionet deployment address (the ONLY value that changes per release)
VITE_PACTUM_CONTRACT=0x5c0215CCbd74D4270eF1bf3aF17F43C78B3851dc

# Hard-locked network; changing these makes the app refuse to boot.
VITE_GENLAYER_CHAIN_ID=61999
VITE_GENLAYER_RPC_URL=https://studio.genlayer.com/api
VITE_GENLAYER_EXPLORER=https://explorer-studio.genlayer.com
